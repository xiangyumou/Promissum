# =============================================================================
# Promissum Test Environment Configuration
# =============================================================================
# Copy this file to .env.test for running tests
# DO NOT commit actual .env.test files to version control
# =============================================================================

NODE_ENV=test

# Test database (separate from development)
DATABASE_URL=postgresql://promissum:promissum_password@promissum-db:5432/promissum_test

# Test Chaster API configuration
CHASTER_API_URL=http://chaster:3000/api/v1
CHASTER_API_TOKEN=test_token_for_api_only

# Test public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATE_FORMAT=yyyy-MM-dd HH:mm
NEXT_PUBLIC_AUTO_REFRESH_INTERVAL=60
NEXT_PUBLIC_CACHE_TTL=5
