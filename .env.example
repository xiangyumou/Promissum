# =============================================================================
# Promissum Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development with Docker
# DO NOT commit actual .env files to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application (Next.js) - Server-side only
# -----------------------------------------------------------------------------

# Node environment (development | production)
NODE_ENV=development

# Port for the Next.js server (default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Chaster API Configuration
# -----------------------------------------------------------------------------

# URL of the Chaster API service
# - Local development (Docker): http://chaster:3000/api/v1
# - Local development (standalone): http://localhost:3001/api/v1
# - Production: http://chaster:3000/api/v1
CHASTER_API_URL=http://chaster:3000/api/v1

# API token for authenticating with Chaster service
# Generate this in the Chaster service with `npm run token`
CHASTER_API_TOKEN=your_secure_random_token_here

# -----------------------------------------------------------------------------
# Public Variables (Client-side accessible)
# Note: These must start with NEXT_PUBLIC_ to be exposed to the browser
# -----------------------------------------------------------------------------

# Public URL of this application
# - Local: http://localhost:3000
# - Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Date format for display (e.g. yyyy-MM-dd HH:mm)
NEXT_PUBLIC_DATE_FORMAT=yyyy-MM-dd HH:mm

# Auto-refresh interval in seconds
NEXT_PUBLIC_AUTO_REFRESH_INTERVAL=60

# Cache TTL in minutes
NEXT_PUBLIC_CACHE_TTL=5

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# - Local development (Docker): postgresql://promissum:promissum_password@promissum-db:5432/promissum
# - Production: Use docker-compose defaults or external PostgreSQL
DATABASE_URL=postgresql://promissum:promissum_password@promissum-db:5432/promissum

# Direct PostgreSQL configuration (used by docker-compose)
POSTGRES_USER=promissum
POSTGRES_PASSWORD=promissum_password
POSTGRES_DB=promissum
