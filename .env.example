# Usage: Copy to .env (Docker) or .env.local (local dev)
# Note: Do not commit actual .env files

# Docker only: Host port mapping
APP_PORT=3000

# Drand: Set to true only for quick UI testing (decryption is instant)
MOCK_DRAND=false

# Public URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
