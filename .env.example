# Usage: Copy to .env (Docker) or .env.local (local dev)
# Note: Do not commit actual .env files

# App
NODE_ENV=development
PORT=3000
APP_PORT=3000

# Database (SQLite)
# Docker: /data/promissum.db | Local: ./promissum.db
DATABASE_URL=./promissum.db

# Drand (encryption)
# Set MOCK_DRAND=false in production
MOCK_DRAND=true
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# Public vars (client-side)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATE_FORMAT=yyyy-MM-dd HH:mm
NEXT_PUBLIC_AUTO_REFRESH_INTERVAL=60
NEXT_PUBLIC_CACHE_TTL=5
